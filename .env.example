# =================================================================
# CẤU HÌNH GỬI EMAIL TỰ ĐỘNG THỰC TẾ QUA GOOGLE GMAIL SMTP
# =================================================================
# Để server tự động gửi thư báo cháy vào hòm thư Gmail (Inbox thật):
# 1. Bật xác thực 2 bước (2-Step Verification) trên tài khoản Google:
#    https://myaccount.google.com/security
# 2. Tạo Mật khẩu ứng dụng (App Password 16 chữ số):
#    https://myaccount.google.com/apppasswords
#    (Chọn Tên ứng dụng: ví dụ "Smart Fire Clock", nhấn Tạo -> Copy 16 chữ số)
# 3. Điền vào 2 dòng bên dưới (bỏ khoảng trắng):

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cổng khởi chạy Server Web
PORT=3000

# Gmail mặc định nhận cảnh báo (nếu chưa gán trên Web)
DEFAULT_ALERT_EMAIL=lx426352@gmail.com

# Tùy chọn AI: Khóa API OpenAI GPT (nếu có, không bắt buộc)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
